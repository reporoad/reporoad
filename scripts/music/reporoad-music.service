[Unit]
Description=RepoRoad local music and site proxy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/reporoad
EnvironmentFile=%h/.config/reporoad/music.env
ExecStart=/usr/bin/node scripts/music/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
# Loopback only. This development proxy must never be exposed to the Internet.

[Install]
WantedBy=default.target
