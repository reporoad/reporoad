# Public viewer IDs, NOT the RTMP stream key or YouTube Studio URL.
# Copy to .dev.vars for local development; configure the same runtime variables
# in Sites environment settings for the published website.

# The channel whose current live broadcast the player follows. Changing it is the
# only change needed when the broadcaster opens a new event.
YOUTUBE_CHANNEL_ID=UCV6R_O0gxuj2tNcQWq7yJ3g

# Chat fallback. Live chat can only be embedded for one concrete video, so the
# server looks the current broadcast up from the channel. This value is used
# while that lookup is unavailable. No API key or cloud project is needed.
YOUTUBE_VIDEO_ID=WuLbv_j9CGE
